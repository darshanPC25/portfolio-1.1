# Copy to backend/.env (gitignored) and fill in. Spring Boot reads this file
# automatically when started from the backend/ directory.

# Database — must match the values in the project-root .env used by Docker Compose.
DB_URL=jdbc:postgresql://localhost:5432/portfolio
DB_USERNAME=portfolio
DB_PASSWORD=change-me

# Server
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Contact form
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW=10m
# Any long random string. Used to hash sender IP addresses before storing them.
CONTACT_IP_HASH_SALT=

# First administrator for Portfolio Studio. Created once, only while no
# administrator exists; ignored afterwards. Password: 12–64 characters.
# Remove ADMIN_PASSWORD after the first start (change it later in Studio > Settings).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Darshan

# Sessions and uploads
SESSION_COOKIE_SECURE=false      # true when the site is served over HTTPS
ADMIN_SESSION_TIMEOUT=2h
UPLOAD_DIRECTORY=./data/uploads
