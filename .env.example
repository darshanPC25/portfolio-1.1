# Copy to .env (gitignored) in the project root. Read by docker-compose.yml.
# Use the same username, password and port in backend/.env (DB_URL).
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
# Host port. Change it (e.g. 5433) if a PostgreSQL installed on this machine already uses 5432.
POSTGRES_PORT=5432
