# Production settings for docker-compose.prod.yml.
# Copy to .env.production (gitignored), fill in, and keep it off version control.

# Public address of the site, exactly as visitors type it (no trailing slash).
# Used for CORS, the sitemap and robots.txt.
SITE_URL=https://your-domain.example

# Host port the web container listens on (your TLS proxy forwards to it).
WEB_PORT=8088

# Database. Use a long random password, e.g. `openssl rand -base64 32`.
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=

# Long random string used to hash contact-form sender IP addresses.
CONTACT_IP_HASH_SALT=

# Session cookie is sent only over HTTPS. Set false ONLY for a local HTTP trial.
SESSION_COOKIE_SECURE=true

# First administrator, created on the first start while no administrator exists.
# Password: 12–64 characters. Remove ADMIN_PASSWORD after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Darshan
